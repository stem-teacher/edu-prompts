CREATE entity CONTENT {"id":"concept:M5-3-4","type":"Deliverable","props":{"kind":"Concept","module":"module:M5","inquiry_question":"iq:M5-3","statement":"evaluate the validity of the investigation","definition":"An experiment is valid if its method is appropriate and directly tests the intended hypothesis. Core components include controlling variables, having a single independent variable, and appropriate measurement of the dependent variable.","hsc_example":"(2021 Q22b - GMO Mice): An experiment tested if genetically modified mice on a high-fat diet gained more weight. To be valid, it required four groups to isolate the effects of the gene and the diet, including a control group (normal mice, normal diet) and a hypothesis test group (GMO mice, high-fat diet)."},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
CREATE entity CONTENT {"id":"concept:M5-3-5","type":"Deliverable","props":{"kind":"Concept","module":"module:M5","inquiry_question":"iq:M5-3","statement":"evaluate the reliability of the investigation","definition":"An experiment is reliable if the results are consistent and repeatable. This is achieved through repetition (at least 3 trials) and using a sufficiently large sample size.","hsc_example":"(2020 Q25a - Self-Injection): A researcher injected herself with a bacterium to see if it caused a disease. This experiment is unreliable because the sample size is only one, making it impossible to know if the result is consistent or a one-off personal reaction."},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
CREATE entity CONTENT {"id":"iq:M5-4","type":"Deliverable","props":{"kind":"InquiryQuestion","module":"module:M5","title":"What is the structure of an investigative report?"},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
CREATE entity CONTENT {"id":"concept:M5-4-1","type":"Deliverable","props":{"kind":"Concept","module":"module:M5","inquiry_question":"iq:M5-4","statement":"review a published and peer-reviewed scientific report to determine the conventions of writing a report on a practical investigation","definition":"A formal scientific report follows a clear structure (Aim, Hypothesis, Method, Results, Discussion, Conclusion). The language must be objective, in the third person, and use precise scientific terminology.","hsc_example":"(2023 Q30 - Student Report): A student's report was criticised for using informal headings like 'My prediction is' instead of 'Hypothesis' and for describing results with colloquial language ('spurt height') instead of quantitative data in a table."},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
CREATE entity CONTENT {"id":"concept:M5-4-2","type":"Deliverable","props":{"kind":"Concept","module":"module:M5","inquiry_question":"iq:M5-4","statement":"use a sample of a published and peer-reviewed secondary source to identify the purpose, language style, presentation and structure of the report"},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
