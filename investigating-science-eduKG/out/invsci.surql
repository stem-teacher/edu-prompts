CREATE entity CONTENT {"id":"iq:M6-2","type":"Deliverable","props":{"kind":"InquiryQuestion","module":"module:M6","title":"How have developments in technology led to advances in scientific theories and laws that, in turn, drive the need for further developments in technology?"},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
CREATE entity CONTENT {"id":"concept:M6-2-1","type":"Deliverable","props":{"kind":"Concept","module":"module:M6","inquiry_question":"iq:M6-2","statement":"using examples, assess the impact that developments in technologies have had on the accumulation of evidence for scientific theories, laws and models","definition":"Science and technology have a feedback loop. New technology enables new scientific understanding, which in turn enables the development of even newer technology.","hsc_example":"(2024 Q36 - DNA & GMOs): X-ray crystallography (technology) was essential for Franklin to produce Photo 51. This image (science) allowed Watson and Crick to develop the double helix model of DNA. This new understanding enabled the development of recombinant DNA technology to create GMOs (new technology)."},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
CREATE entity CONTENT {"id":"concept:M6-2-2","type":"Deliverable","props":{"kind":"Concept","module":"module:M6","inquiry_question":"iq:M6-2","statement":"using examples, assess the impact that developments in scientific theories, laws and models have had on the development of new technologies"},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
