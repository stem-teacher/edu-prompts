CREATE entity CONTENT {"id":"concept:M8-3-4","type":"Deliverable","props":{"kind":"Concept","module":"module:M8","inquiry_question":"iq:M8-3","statement":"using examples, analyse the impacts that governments and large corporations have on scientific research","definition":"Economic and political forces significantly influence science. A conflict of interest occurs when a researcher's private interests (e.g., financial ties to a company) could improperly influence their professional judgment.","hsc_example":"(2022 Q33b - Corporate Funding & 2020 Q32c - Climate Change): Increased corporate funding for science can create pressure for results favourable to the funder's products. An astrophysicist funded by oil companies claiming water vapour is the main cause of climate change is a major conflict of interest, as the fossil fuel industry has a financial stake in downplaying CO₂'s role."},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
CREATE entity CONTENT {"id":"concept:M8-3-5","type":"Deliverable","props":{"kind":"Concept","module":"module:M8","inquiry_question":"iq:M8-3","statement":"evaluate how personal, cultural and socioeconomic perspectives can influence the direction of scientific research","definition":"Social and political factors influence science. Scientific evidence can be used to inform political decisions and shape public opinion.","hsc_example":"(2019 Q30b - Franklin River Dam): Scientists provided evidence on the negative environmental impacts of a proposed dam. This evidence was used by activists (social factor) and ultimately influenced a High Court decision to stop the dam (political outcome), demonstrating the interplay between science and society."},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
