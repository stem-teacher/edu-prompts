CREATE entity CONTENT {"id":"concept:M8-2-1","type":"Deliverable","props":{"kind":"Concept","module":"module:M8","inquiry_question":"iq:M8-2","statement":"investigate the need for the regulation of scientific research"},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
CREATE entity CONTENT {"id":"concept:M8-2-2","type":"Deliverable","props":{"kind":"Concept","module":"module:M8","inquiry_question":"iq:M8-2","statement":"investigate and assess ethical issues surrounding current scientific research","definition":"Ethical research is governed by core principles (NHMRC): Informed Consent (participants are briefed on risks), Beneficence (maximise benefits, minimise harm), and Justice (fair selection of participants).","hsc_example":"(2020 Q25b - Ethics Committee): For a researcher who self-injected a bacterium, an ethics committee would likely require prior investigation on animal models to decrease the risk of human harm and would enforce strict animal welfare protocols."},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
