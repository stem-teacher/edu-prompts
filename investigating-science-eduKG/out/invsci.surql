CREATE entity CONTENT {"id":"concept:M7-5-3","type":"Deliverable","props":{"kind":"Concept","module":"module:M7","inquiry_question":"iq:M7-5","statement":"evaluate the increasing volume of scientific papers being published and assess the feasibility of science to effectively manage, review, replicate and validate investigations"},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
CREATE entity CONTENT {"id":"concept:M7-5-4","type":"Deliverable","props":{"kind":"Concept","module":"module:M7","inquiry_question":"iq:M7-5","statement":"analyse the benefits of peer review in relation to the advancement of science","definition":"Peer review is the evaluation of scientific work by other experts in the same field to ensure its quality and validity before it is published. It acts as a critical quality control filter.","hsc_example":"(2019 Q29b - Marshall & Warren): Marshall and Warren's paper on H. pylori causing ulcers was peer-reviewed before publication. This process ensured their revolutionary idea was scrutinised for validity and methodological rigour, which helped it gain acceptance and advance medicine."},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
