CREATE entity CONTENT {"id":"concept:M7-3-1","type":"Deliverable","props":{"kind":"Concept","module":"module:M7","inquiry_question":"iq:M7-3","statement":"evaluate how evidence of a correlation can be misinterpreted as causation","definition":"Correlation is a relationship where two variables change together, but it does not imply one causes the other. Causation is where a change in one variable directly causes a change in another. Mistaking correlation for causation is a common logical fallacy.","hsc_example":"(2019 Q25c - Whales & CO₂): A graph showed that as whale sightings increased, atmospheric CO₂ also increased. A student incorrectly infers that the whales cause the increase in CO₂. This is a correlation, not causation, as a third factor (e.g., global economic growth) could be responsible for both trends."},"provenance":{"source":"docx","captured_at":"2025-08-31T00:00:00Z","agent_id":"agent:extractor","tool":"script"}};
